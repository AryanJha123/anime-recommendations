    "    for rec in recs:\n",
    "        if rec not in anime_list:\n",
    "            if rec in total_recs:\n",
    "                total_recs[rec] += recs.index(rec)\n",
    "            else:\n",
    "                total_recs[rec] = recs.index(rec)"
   ]
